# Supabase 대시보드 > Project Settings > API (또는 Connect 버튼) 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon public key 또는 publishable key(sb_publishable_...) 둘 다 사용 가능
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 강아지 대화용 Gemini API 키 (https://aistudio.google.com/apikey)
# 서버에서만 쓰므로 NEXT_PUBLIC_ 을 붙이지 마세요!
GEMINI_API_KEY=your-gemini-api-key
# (선택) 사용할 모델. 기본값은 가장 저렴한 최신 Flash-Lite 별칭
# GEMINI_MODEL=gemini-flash-lite-latest
